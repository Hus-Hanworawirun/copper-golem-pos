{
  "name": "copper-golem-pos",
  "version": "1.0.0",
  "description": "Copper Golem POS - Desktop Retail POS and Stock Accounting System",
  "main": "electron-main.js",
  "scripts": {
    "start": "node server/index.js",
    "dev:server": "node server/index.js",
    "dev:client": "vite",
    "dev": "concurrently \"node server/index.js\" \"vite\"",
    "electron": "electron electron-main.js",
    "build": "vite build",
    "build:exe": "npm run build && electron-builder --win",
    "db:clear": "node server/clear.js",
    "db:seed": "node server/seed.js"
  },
  "build": {
    "appId": "com.coppergolem.pos",
    "productName": "Copper Golem POS",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "server/**/*",
      "uploads/**/*",
      "electron-main.js",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Copper Golem POS"
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "better-sqlite3": "^13.1.1",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "jsbarcode": "^3.12.3",
    "lucide-react": "^1.72.0",
    "multer": "^2.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.6.2",
    "concurrently": "^10.0.7",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "postcss": "^8.5.32",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.8"
  }
}
